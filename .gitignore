# Build trees, venv, and local tooling — never committed (mirrors hrx/.gitignore).
/build/
/build-*/
/.venv/
/out/
/tools-bin/
/.cache/
# per-project local build dirs (submodules are tracked only as gitlinks)
projects/*/bld/
projects/*/build/
projects/*/build-*/
# generated at configure time
**/version.h
*.log
*_aie_cdo_*.bin
# run_e2e.py's functions are importable (and unit-testable); python caches the bytecode
__pycache__/
