+    def empty_dispatch_ns(self) -> int | None:
+        """Time one dispatch that does nothing, on this kernel's xclbin.
+
+        It is a transaction with the header of the last one dispatched and
+        no operations, in an executable of its own: libhrx gives each
+        executable its own hardware context, so the context is this kernel's
+        configuration rather than this kernel's context itself.
+
+        Returns:
+            Nanoseconds from submit to completion, timed as a run is; None
+            before a transaction has been dispatched, or without a context.
+
+        Raises:
+            HostRuntimeError: The empty dispatch failed.
+        """
+        if self._ctx is None or self.txn_header is None:
+            return None
+        header = self.txn_header.tobytes()
+        if self._empty is None or self._empty[2] != header:
+            if self._empty is not None:
+                self._ctx.release_executable(self._empty[0])
+                self._empty = None
+            words = self.txn_header.copy()
+            words[2:4] = (0, words.nbytes)
+            try:
+                exe = self._ctx.create_executable(
+                    self.xclbin_image(), words.tobytes(), self.kernel_name
+                )
+                try:
+                    ordv = self._ctx.lookup_export(exe, self.kernel_name)
+                except BaseException:
+                    self._ctx.release_executable(exe)
+                    raise
+            except HRXError as e:
+                raise HostRuntimeError(
+                    f"HRX failed to load an empty dispatch: {e}"
+                ) from e
+            self._empty = (exe, ordv, header)
+        start = time.perf_counter_ns()
+        try:
+            self._ctx.dispatch(self._empty[0], self._empty[1], [])
+            self._ctx.synchronize()
+        except HRXError as e:
+            raise HostRuntimeError(f"An empty HRX dispatch failed: {e}") from e
+        return time.perf_counter_ns() - start
+
+
+def _txn_header(insts: bytes) -> np.ndarray:
+    """The four-word XAie transaction header of ``insts.bin`` words or an ELF's."""
+    if insts[:4] == b"\x7fELF":
+        insts = control_code_from_elf(insts).tobytes()
+    return np.frombuffer(insts[:16], dtype=np.uint32).copy()
+
 
