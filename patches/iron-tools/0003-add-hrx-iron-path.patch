+extern "C" {
+int iron_build_xadx(const uint8_t *xclbin, size_t xclbin_n, const uint32_t *cc,
+                    size_t cc_n, const uint32_t *patch, size_t patch_n,
+                    const char *entry_name, uint8_t **out, size_t *out_n);
+void iron_free_xadx(uint8_t *p);
