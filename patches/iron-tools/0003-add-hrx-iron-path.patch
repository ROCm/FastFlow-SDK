+    text = msg_ptr.value.decode("utf-8", "replace") if msg_ptr.value else "?"
+    # to_string may allocate the message; free it.
+    if msg_ptr.value:
+        _hrx_status_free_message(msg_ptr)
+    _hrx_status_ignore(s2)
+    _hrx_status_ignore(status)
