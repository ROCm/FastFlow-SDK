+++ b/python/utils/hostruntime/hrxruntime/discovery.py
@@ -0,0 +1,56 @@
+# SPDX-FileCopyrightText: Copyright (C) 2026 Advanced Micro Devices, Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Filesystem discovery for the HRX runtime (no ctypes / no dlopen).
+
+The C++ host stack consumes the installed ``hrx::hrx`` package target. This
+module locates the corresponding shared library for Python ctypes, treating
+the ``HRX_*`` environment variables only as high-priority *hints*. XADX
+serialization is part of libhrx's public amdxdna executable API, so no separate
+builder library or build-tree discovery is required.
+"""
+
+import os
+from pathlib import Path
+from typing import List, Optional
+
+__all__ = [
+    "find_libhrx",
+    "hrx_available",
+]
+
+_LIBHRX_NAME = "hrx.dll" if os.name == "nt" else "libhrx.so"
+
+
+def _existing(paths: List[Optional[str]]) -> List[str]:
+    out = []
+    for p in paths:
+        if p and Path(p).is_file() and p not in out:
+            out.append(p)
+    return out
+
+
+def find_libhrx() -> Optional[str]:
+    """Locate the HRX shared library, honoring env hints then standard locations."""
+    libhrx_dir = os.environ.get("LIBHRX_DIR")
+    hrx_install = os.environ.get("HRX_INSTALL")
+
+    candidates: List[Optional[str]] = [
+        os.environ.get("HRX_LIBHRX"),
+        os.path.join(libhrx_dir, _LIBHRX_NAME) if libhrx_dir else None,
+        os.path.join(
+            hrx_install, "bin" if os.name == "nt" else "lib", _LIBHRX_NAME
+        )
+        if hrx_install
+        else None,
+    ]
+    if os.name != "nt":
+        candidates += ["/usr/lib/libhrx.so", "/usr/local/lib/libhrx.so"]
+
+    found = _existing(candidates)
+    return found[0] if found else None
+
+
+def hrx_available() -> bool:
+    """Cheap capability probe: True if the HRX shared library is locatable."""
+    return find_libhrx() is not None
