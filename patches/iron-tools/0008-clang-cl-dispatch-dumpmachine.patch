diff --git a/python/utils/compile/utils.py b/python/utils/compile/utils.py
index 082a657a63d..99a653e033e 100644
--- a/python/utils/compile/utils.py
+++ b/python/utils/compile/utils.py
@@ -40,21 +40,58 @@ SHARED_LIB_SUFFIX = ".dll" if os.name == "nt" else ".so"
 SHARED_LIB_FLAGS = ["-shared"] if os.name == "nt" else ["-shared", "-fPIC"]
 
 
+def _msvc_style_driver(compiler: str) -> bool:
+    """True for ``clang-cl`` and ``cl``, which reject GCC driver flags."""
+    return Path(compiler).stem.lower() in {"clang-cl", "cl"}
+
+
+def _msvc_opt_flag(opt: str) -> str:
+    """Translate a GCC ``-O*`` level into the MSVC spelling."""
+    if opt == "-O0":
+        return "/Od"
+    if opt.startswith("-"):
+        return "/" + opt[1:]
+    return opt
+
+
+def _windows_reproducible_link_flag(compiler: str) -> str:
+    """Keep a GCC-driven Windows dispatch DLL from embedding a timestamp.
+
+    Identical builds must hash the same. A triple containing ``msvc`` takes
+    ``/Brepro``; every other GCC-style driver takes ``--no-insert-timestamp``.
+    ``clang-cl`` and ``cl`` do not use this helper.
+    """
+    target = subprocess.run(
+        [compiler, "-dumpmachine"],
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+    if "msvc" in target:
+        return "-Wl,/Brepro"
+    return "-Wl,--no-insert-timestamp"
+
+
 def host_shared_lib_cmd(src: Path, out: Path, *, opt: str, includes=()) -> list[str]:
     """Build a host shared library with the project's C++17 ABI."""
     compiler = config.host_cxx_path()
+    if _msvc_style_driver(compiler):
+        # clang-cl ignores -shared and -std=c++17, and it parses -Wl,/Brepro
+        # as a -W warning name. The generated transaction source is C++17.
+        return [
+            compiler,
+            "/LD",
+            _msvc_opt_flag(opt),
+            "/std:c++17",
+            *(f"/I{inc}" for inc in includes),
+            str(src),
+            f"/Fe:{out}",
+            "/link",
+            "/Brepro",
+        ]
     link_flags = []
     if SHARED_LIB_SUFFIX == ".dll":
-        target = subprocess.run(
-            [compiler, "-dumpmachine"],
-            check=True,
-            capture_output=True,
-            text=True,
-        ).stdout.strip()
-        # PE timestamps must not give identical dispatch builds different hashes.
-        link_flags.append(
-            "-Wl,/Brepro" if "msvc" in target else "-Wl,--no-insert-timestamp"
-        )
+        link_flags.append(_windows_reproducible_link_flag(compiler))
     return [
         compiler,
         *SHARED_LIB_FLAGS,
diff --git a/test/python/test_config.py b/test/python/test_config.py
index 6e2fc68fa0a..7cacc9b5a05 100644
--- a/test/python/test_config.py
+++ b/test/python/test_config.py
@@ -121,6 +121,34 @@ def test_host_shared_library_link_flags(monkeypatch, tmp_path, suffix, target, f
         assert not calls
 
 
+@pytest.mark.parametrize("compiler", ["clang-cl.exe", "cl.exe"])
+def test_msvc_style_dispatch_command(monkeypatch, tmp_path, compiler):
+    from aie.utils.compile import utils as compile_utils
+
+    def fail_if_called(*args, **kwargs):
+        raise AssertionError(args)
+
+    monkeypatch.setattr(config, "host_cxx_path", lambda: rf"C:\LLVM\bin\{compiler}")
+    monkeypatch.setattr(compile_utils.subprocess, "run", fail_if_called)
+    out = tmp_path / "dispatch.dll"
+    command = compile_utils.host_shared_lib_cmd(
+        tmp_path / "source.cpp",
+        out,
+        opt="-O2",
+        includes=[tmp_path / "include"],
+    )
+    assert command[0].endswith(compiler)
+    assert "/LD" in command
+    assert "/O2" in command
+    assert "/std:c++17" in command
+    assert f"/I{tmp_path / 'include'}" in command
+    assert f"/Fe:{out}" in command
+    assert command[-2:] == ["/link", "/Brepro"]
+    assert "-shared" not in command
+    assert "-std=c++17" not in command
+    assert not any(arg.startswith("-Wl,") or arg.startswith("-W") for arg in command)
+
+
 def _write_tool(directory, name, exit_code=0):
     """Create a real executable that reports a version and exits `exit_code`."""
