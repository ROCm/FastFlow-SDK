diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
index 1c7581c6c3c..c6f594d08ef 100644
--- a/python/CMakeLists.txt
+++ b/python/CMakeLists.txt
@@ -329,6 +329,17 @@ if (AIE_ENABLE_PYTHON_PASSES)
 
 else ()
 
+  set(_aie_mlir_embed_capi_link_libs AIECAPI)
+  set(_aie_mlir_private_link_libs LLVMSupport)
+  if(MSVC)
+    # CMake's MSVC/Ninja link response for AIEAggregateCAPI can drop the
+    # lib/CAPI prefix from obj.AIECAPI object paths when the common aggregate
+    # embeds AIECAPI as raw objects. Link AIECAPI into _aie directly on MSVC
+    # and keep the common aggregate for the upstream MLIR CAPI libraries.
+    set(_aie_mlir_embed_capi_link_libs)
+    list(APPEND _aie_mlir_private_link_libs AIECAPI)
+  endif()
+
   # Standard Python C extension bindings.
   declare_mlir_python_extension(AIEPythonExtensions.MLIR
     MODULE_NAME _aie
@@ -339,9 +350,9 @@ else ()
     SOURCES
       AIEMLIRModule.cpp
     EMBED_CAPI_LINK_LIBS
-      AIECAPI
+      ${_aie_mlir_embed_capi_link_libs}
     PRIVATE_LINK_LIBS
-      LLVMSupport
+      ${_aie_mlir_private_link_libs}
   )
 
   if(AIE_ENABLE_XRT_PYTHON_BINDINGS)
