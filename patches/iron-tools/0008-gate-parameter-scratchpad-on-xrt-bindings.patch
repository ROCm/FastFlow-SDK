diff --git a/python/CMakeLists.txt b/python/CMakeLists.txt
--- a/python/CMakeLists.txt
+++ b/python/CMakeLists.txt
@@ -302,8 +302,10 @@ install(
 ################################################################################
 # ParameterScratchpad pybind11 module (uses a raw buffer)
 ################################################################################
-# XRT-free (TEST_UTILS_USE_XRT=0), and the host runtime imports it on every
-# platform, so it is built whether or not the XRT Python bindings are.
+# XRT-free (TEST_UTILS_USE_XRT=0), but only the XRT host runtime imports it,
+# after pyxrt, so it is built only with the XRT Python bindings. Without them it
+# could never load, and as a pybind11 module it would tie an otherwise
+# stable-ABI installation to one CPython.
 #
 # Ask the target interpreter for its pybind11 first: a plain
 # find_package(pybind11 CONFIG) searches the whole CMake package path and
@@ -312,6 +314,7 @@ install(
 # compiles cleanly but breaks at the ABI (e.g. a PyFrameObject layout the
 # headers don't expect), so only fall back to the unqualified search when
 # Python3_EXECUTABLE has no pybind11 of its own to report.
+if(AIE_ENABLE_XRT_PYTHON_BINDINGS)
 execute_process(
   COMMAND "${Python3_EXECUTABLE}" -m pybind11 --cmakedir
   RESULT_VARIABLE _pybind11_cmakedir_result
@@ -362,6 +365,7 @@ install(TARGETS _parameter_scratchpad
   RUNTIME DESTINATION "${AIE_PYTHON_INSTALL_DIR}/aie/_mlir_libs"
   COMPONENT aie-python
 )
+endif()
 
 target_include_directories(AIEPythonModules.extension._aie.dso PUBLIC ${VITIS_AIETOOLS_DIR}/include)
 
