From: FastFlow SDK <fastflow-sdk@amd.com>
Subject: [PATCH] Prefer explicit XRT include/lib dirs over pkg-config

When the caller already set XRT_INCLUDE_DIR and XRT_LIB_DIR (for example
`dev.py build fastflowlm-xrt` passing the discovered host install), skip
pkg_check_modules(XRT). Distro xrt.pc is often broken (prefix=/usr//usr)
and would otherwise override the known host paths. pkg-config remains the
discovery fallback when those cache variables are unset.

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index f07b89d..43300af 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -64,8 +64,10 @@ set(FLM_ENGINE_LIB_DIR "${CMAKE_SOURCE_DIR}/lib/${FLM_RUNTIME_NAME}")
 # ———————————————————————————————————————————————
 # NPU runtime discovery.
 #   HRX: consumed from its public CMake package via find_package(hrx).
-#   XRT: discovered via pkg-config (system install), a manual /opt/xilinx/xrt
-#        fallback, or fetched from source for a portable build.
+#   XRT: caller-provided XRT_INCLUDE_DIR/XRT_LIB_DIR, else pkg-config (system
+#        install), a manual /opt/xilinx/xrt fallback, or fetched from source
+#        for a portable build. Explicit dirs win so a broken distro xrt.pc
+#        (prefix=/usr//usr) cannot override a known host install.
 # ———————————————————————————————————————————————
 if(FLM_USE_HRX)
     find_package(hrx CONFIG REQUIRED)
@@ -75,7 +77,13 @@ else()
         set(XRT_LIB_DIR     C:/dev/xrtNPUfromDLL                    CACHE PATH "Where XRT libs live")
     else()
         find_package(PkgConfig)
-        if(PkgConfig_FOUND)
+        # Honor -DXRT_INCLUDE_DIR / -DXRT_LIB_DIR from the caller (for example
+        # `dev.py build fastflowlm-xrt`). pkg-config is only a discovery
+        # fallback; distro xrt.pc is often broken and must not win.
+        if(XRT_INCLUDE_DIR AND XRT_LIB_DIR)
+            message(STATUS "Using provided XRT_INCLUDE_DIR=${XRT_INCLUDE_DIR}")
+            message(STATUS "  XRT_LIB_DIR=${XRT_LIB_DIR}")
+        elseif(PkgConfig_FOUND)
             pkg_check_modules(XRT xrt)
             if(XRT_FOUND)
                 message(STATUS "Found XRT via pkg-config")
