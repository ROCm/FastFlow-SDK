-    for (uint8_t c : b) {
-        h1 ^= c;
-        h1 *= 1099511628211ULL;                  // FNV prime
-        h2 += c;
+
+inline xclbin_digest compute_xclbin_digest(const std::vector<uint8_t>& bytes) {
+    uint64_t h1 = 1469598103934665603ULL;
+    uint64_t h2 = 0xcbf29ce484222325ULL ^ bytes.size();
+    for (uint8_t value : bytes) {
+        h1 ^= value;
+        h1 *= 1099511628211ULL;
+        h2 += value;
         h2 += h2 << 10;
