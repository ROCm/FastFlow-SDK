-    uint64_t h1 = 0;  // FNV-1a-64
-    uint64_t h2 = 0;  // Jenkins one-at-a-time (64-bit)
-    bool operator==(const xclbin_digest& o) const {
-        return h1 == o.h1 && h2 == o.h2;
-    }
+    uint64_t h1 = 0;
+    uint64_t h2 = 0;
