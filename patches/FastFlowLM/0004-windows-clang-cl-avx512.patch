From: FastFlow SDK <fastflow-sdk@amd.com>
Subject: [PATCH] Compile Windows AVX code for clang-cl

clang-cl ignores GCC -mavx/-mavx512f and rejects those intrinsics unless
the translation unit names the ISA. Linux already passes -mavx -mavx2 on
flm and -mavx512f on the AVX-512 helpers. Use /arch:AVX2 for the Windows
flm target and /arch:AVX512 for the AVX-512 files and the Gemma 4 engine.
clang-cl also links the dynamic CRT, matching HRX.

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 04da43d..f39bb28 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -332,6 +332,16 @@ if(NOT WIN32)
 
     # Define a macro to indicate limited model support on Linux
     # add_compile_definitions(FASTFLOWLM_LINUX_LIMITED_MODELS=1)
+else()
+    # clang-cl ignores the GCC -m flags above and rejects AVX-512 intrinsics
+    # unless the translation unit is built for that ISA. /arch:AVX512 is the
+    # clang-cl and cl.exe spelling.
+    set_source_files_properties(
+        ${CMAKE_SOURCE_DIR}/common/image_process_utils/imageprocAVX512.cpp
+        ${CMAKE_SOURCE_DIR}/common/audio_process_utils/audioprocAVX512.cpp
+        PROPERTIES
+        COMPILE_OPTIONS "/arch:AVX512"
+    )
 endif()
 
 
@@ -666,6 +676,11 @@ if(NOT WIN32)
 
     # Link with dl library for dlopen() support (used for preloading bundled libraries)
     target_link_libraries(flm PUBLIC dl)
+else()
+    # clang-cl rejects AVX intrinsics unless the target ISA is enabled.
+    # /arch:AVX2 matches the -mavx -mavx2 flags above. AVX-512 translation
+    # units add /arch:AVX512, which supersedes this flag.
+    target_compile_options(flm PUBLIC /arch:AVX2)
 endif()
 
 # ———————————————————————————————————————————————
diff --git a/src/detail/CMakeLists.txt b/src/detail/CMakeLists.txt
index 16870c5b..5755b69f 100644
--- a/src/detail/CMakeLists.txt
+++ b/src/detail/CMakeLists.txt
@@ -16,8 +16,16 @@ list(APPEND GEMMA4E_SHARED_SOURCES "${GEMMA4E_ENGINE_DIR}/vision_common/norm.cpp
 add_library(gemma4e_npu SHARED ${GEMMA4E_SOURCES} ${GEMMA4E_SHARED_SOURCES})
 
 if(MSVC)
+    # cl.exe keeps the static CRT this target asks for. clang-cl also takes
+    # the MSVC branch, but it links the /MD HRX and vcpkg libraries, so the
+    # static runtime would mismatch those import libs.
+    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
+        set(_gemma4e_msvc_runtime "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+    else()
+        set(_gemma4e_msvc_runtime "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
+    endif()
     set_target_properties(gemma4e_npu PROPERTIES
-        MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>"
+        MSVC_RUNTIME_LIBRARY "${_gemma4e_msvc_runtime}"
         WINDOWS_EXPORT_ALL_SYMBOLS ON
     )
 endif()
@@ -59,7 +67,17 @@ if(WIN32)
     )
 endif()
 
-if(NOT MSVC)
+if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
+    target_compile_options(gemma4e_npu PRIVATE /arch:AVX512)
+elseif(MSVC OR CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
+    target_compile_options(gemma4e_npu PRIVATE /arch:AVX512)
+    # The prebuilt import library exports a leaked std::ostream::operator<<(bool).
+    # flm.exe, linked against that library, imports the symbol from this DLL.
+    # Forward it to the CRT. lld-link keeps WINDOWS_EXPORT_ALL_SYMBOLS exports.
+    target_link_options(gemma4e_npu PRIVATE
+        "/EXPORT:??6?\$basic_ostream@DU?\$char_traits@D@std@@@std@@QEAAAEAV01@_N@Z=MSVCP140.??6?\$basic_ostream@DU?\$char_traits@D@std@@@std@@QEAAAEAV01@_N@Z"
+    )
+else()
     target_compile_options(gemma4e_npu PRIVATE
         -O3 -Wall -fmax-errors=1
         -mavx512f -mavx512vl -mavx512bw -mavx512dq -mfma
