From: ROCm NPU staging <rocm-npu@amd.com>
Subject: [PATCH] Skip optional HRX engines missing from lib/hrx

HRX engine coverage can lag FastFlowLM main: new families may ship only
under lib/xrt. When FLM_USE_HRX is on, skip linking and compiling those
engines if the import library is absent, and fail closed if a skipped
family is requested instead of substituting Llama3.

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 647d667..232f201 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -246,6 +246,36 @@ add_subdirectory(${CMAKE_SOURCE_DIR}/../third_party/tokenizers-cpp
 file(GLOB SOURCES "src/*.cpp" "runner/*.cpp" "common/*.cpp" "common/*/*.cpp" "server/*.cpp" "pull/*.cpp" )
 file(GLOB HEADERS "include/*.hpp" "runner/*.hpp" "common/*.hpp" "common/*/*.hpp" "server/*.hpp" "pull/*.hpp")
 
+# HRX engine coverage can lag FastFlowLM main: new families may exist only
+# under lib/xrt. An HRX build skips those engines instead of failing the link.
+function(flm_have_engine name var)
+    if(WIN32)
+        set(_cand "${FLM_ENGINE_LIB_DIR}/${name}.lib")
+    else()
+        set(_cand "${FLM_ENGINE_LIB_DIR}/lib${name}.so")
+    endif()
+    if(EXISTS "${_cand}")
+        set(${var} TRUE PARENT_SCOPE)
+    else()
+        set(${var} FALSE PARENT_SCOPE)
+    endif()
+endfunction()
+
+set(FLM_HAVE_GEMMA4_12B_ENGINE TRUE)
+set(FLM_HAVE_HUNYUAN_ENGINE TRUE)
+if(FLM_USE_HRX)
+    flm_have_engine(gemma4_12b_npu FLM_HAVE_GEMMA4_12B_ENGINE)
+    flm_have_engine(hunyuan_npu FLM_HAVE_HUNYUAN_ENGINE)
+    if(NOT FLM_HAVE_GEMMA4_12B_ENGINE)
+        message(WARNING "Skipping gemma4_12b_npu: not present in ${FLM_ENGINE_LIB_DIR}")
+        list(FILTER SOURCES EXCLUDE REGEX "modeling_gemma4_12b")
+    endif()
+    if(NOT FLM_HAVE_HUNYUAN_ENGINE)
+        message(WARNING "Skipping hunyuan_npu: not present in ${FLM_ENGINE_LIB_DIR}")
+        list(FILTER SOURCES EXCLUDE REGEX "modeling_hunyuan")
+    endif()
+endif()
+
 # Exclude files that depend on missing libraries for Linux
 if(NOT WIN32)
     # list(FILTER SOURCES EXCLUDE REGEX ".*modeling_gemma3\\.cpp$")
@@ -276,6 +306,16 @@ endif()
 
 
 add_executable(flm ${SOURCES} ${HEADERS})
+if(FLM_HAVE_GEMMA4_12B_ENGINE)
+    target_compile_definitions(flm PUBLIC FLM_HAVE_GEMMA4_12B=1)
+else()
+    target_compile_definitions(flm PUBLIC FLM_HAVE_GEMMA4_12B=0)
+endif()
+if(FLM_HAVE_HUNYUAN_ENGINE)
+    target_compile_definitions(flm PUBLIC FLM_HAVE_HUNYUAN=1)
+else()
+    target_compile_definitions(flm PUBLIC FLM_HAVE_HUNYUAN=0)
+endif()
 
 if(WIN32)
     if(VCPKG_TOOLCHAIN)
@@ -423,19 +463,23 @@ target_link_libraries(flm PUBLIC
     gemma_npu
     gemma_text_npu
     gemma4e_npu
-    gemma4_12b_npu
     gpt_oss_npu
     whisper_npu
     gemma_embedding
     lfm2_npu
     phi4_npu
     nanbeige_npu
-    hunyuan_npu
     dequant
     gemm
     lm_head
     mha
 )
+if(FLM_HAVE_GEMMA4_12B_ENGINE)
+    target_link_libraries(flm PUBLIC gemma4_12b_npu)
+endif()
+if(FLM_HAVE_HUNYUAN_ENGINE)
+    target_link_libraries(flm PUBLIC hunyuan_npu)
+endif()
 
 # Link the selected NPU runtime after the detail model libraries above so their
 # runtime references (libhrx / libxrt_coreutil) resolve.
