From: ROCm NPU staging <rocm-npu@amd.com>
Subject: [PATCH] Remove configured paths from installed runtime

The executable already resolves model metadata and xclbins relative to itself,
after honoring explicit environment variables (FLM_CONFIG_PATH,
FLM_MODELINFO_PATH, FLM_XCLBIN_PATH). Remove the obsolete configured-prefix
fallbacks -- and the CMAKE_INSTALL_PREFIX/CMAKE_XCLBIN_PREFIX compile
definitions that feed them -- so release binaries do not retain the build
host's checkout or install paths. a432a07 split model discovery into
find_model_list() and find_model_info(); strip the baked prefix from both as
well as find_xclbin_path().

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index dd4d33f..f07b89d 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -344,8 +344,6 @@ endif()
 
 target_compile_definitions(flm PUBLIC
     DISABLE_ABI_CHECK=1
-    CMAKE_INSTALL_PREFIX="${CMAKE_INSTALL_PREFIX}"
-    CMAKE_XCLBIN_PREFIX="${CMAKE_XCLBIN_PREFIX}"
     __FLM_VERSION__=\"${FLM_VERSION}\"
     __NPU_VERSION__=\"${NPU_VERSION}\"
 )
diff --git a/src/common/utils.cpp b/src/common/utils.cpp
index d4fd9ae..a1548a4 100644
--- a/src/common/utils.cpp
+++ b/src/common/utils.cpp
@@ -20,8 +20,6 @@
 namespace utils {
 
 std::string find_model_list() {
-    std::string install_prefix = CMAKE_INSTALL_PREFIX;
-
     // 1. Check FLM_CONFIG_PATH environment variable
     const char* env_path = std::getenv("FLM_CONFIG_PATH");
     if (env_path && *env_path) {
@@ -47,19 +45,11 @@ std::string find_model_list() {
         return bundle_path;
     }
 
-    // Legacy configured prefix.
-    std::string installed_path = install_prefix + "/share/flm/model_list.json";
-    if (std::filesystem::exists(installed_path)) {
-        return installed_path;
-    }
-
     // If not found, throw an error
     throw std::runtime_error("model_list.json not found. Please set FLM_CONFIG_PATH or place it next to the executable.");
 }
 
 std::string find_model_info() {
-    std::string install_prefix = CMAKE_INSTALL_PREFIX;
-
     // 1. Check FLM_CONFIG_PATH environment variable
     const char* env_path = std::getenv("FLM_MODELINFO_PATH");
     if (env_path && *env_path) {
@@ -79,12 +69,6 @@ std::string find_model_info() {
     if (std::filesystem::exists(exe_relative_path)) {
         return exe_relative_path;
     }
-
-    // Linux: install
-    std::string installed_path = install_prefix + "/share/flm/model_info.json";
-    if (std::filesystem::exists(installed_path)) {
-        return installed_path;
-    }
 #else
     // Windows: Check relative to executable
     std::string exe_dir = get_executable_directory();
@@ -99,8 +83,6 @@ std::string find_model_info() {
 }
 
 std::string find_xclbin_path() {
-    std::string xclbin_prefix = CMAKE_XCLBIN_PREFIX;
-
     // Check FLM_CONFIG_PATH environment variable
     const char* env_path = std::getenv("FLM_XCLBIN_PATH");
     if (env_path && *env_path) {
@@ -136,12 +118,6 @@ std::string find_xclbin_path() {
         return bundle_path;
     }
 
-    // Legacy configured prefix.
-    std::string installed_path = xclbin_prefix;
-    if (std::filesystem::exists(installed_path + "/xclbins")) {
-        return installed_path;
-    }
-
     // If not found, throw an error
     throw std::runtime_error("xclbins not found. Please set FLM_XCLBIN_PATH or place it next to the executable.");
 }
