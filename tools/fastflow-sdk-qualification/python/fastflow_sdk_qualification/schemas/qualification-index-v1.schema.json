{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocm.docs.amd.com/fastflow-sdk/qualification-index-v1.schema.json",
  "title": "FastFlow SDK qualification intake index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "candidate", "policy", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"const": "fastflow-sdk-qualification-index"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_revision", "manifest_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "satisfied", "requirements"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "satisfied": {"const": true},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform_os",
              "profile",
              "target_family",
              "minimum_runs",
              "matched_runs",
              "satisfied"
            ],
            "properties": {
              "platform_os": {"enum": ["linux", "windows"]},
              "profile": {"type": "string", "minLength": 1},
              "target_family": {"type": "string", "minLength": 1},
              "minimum_runs": {"type": "integer", "minimum": 1},
              "matched_runs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "satisfied": {"const": true}
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle_sha256",
          "bundle_path",
          "source_filename",
          "status",
          "profile",
          "started_at",
          "finished_at",
          "source_revision",
          "candidate_manifest_sha256",
          "platform"
        ],
        "properties": {
          "bundle_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bundle_path": {
            "type": "string",
            "pattern": "^runs/[0-9a-f]{64}\\.evidence\\.zip$"
          },
          "source_filename": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "interrupted"]},
          "profile": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "source_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "candidate_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "platform": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "architecture": {"type": "string"},
              "os": {"enum": ["linux", "windows"]},
              "target_family": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
