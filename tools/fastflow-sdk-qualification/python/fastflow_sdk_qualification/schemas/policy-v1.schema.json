{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amd.com/fastflow-sdk/schemas/policy-v1.schema.json",
  "title": "FastFlow SDK qualification release policy",
  "type": "object",
  "required": ["schema_version", "name", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["platform_os", "target_family", "profile", "minimum_runs"],
        "additionalProperties": false,
        "properties": {
          "platform_os": {"enum": ["linux", "windows"]},
          "target_family": {"const": "npu2"},
          "profile": {"type": "string", "minLength": 1},
          "minimum_runs": {"type": "integer", "minimum": 1, "maximum": 128}
        }
      }
    }
  }
}
