{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amd.com/rocm-npu/schemas/qualification-contract-v1.schema.json",
  "title": "ROCm NPU qualification contract v1",
  "type": "object",
  "required": [
    "schema_version", "native_checks", "xadx_cases", "xadx_case_contracts",
    "xadx_materializations", "xadx_execution", "xadx_provenance",
    "profiles", "policies"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "native_checks": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string"}
    },
    "xadx_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "xadx_case_contracts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/case_contract"}
    },
    "xadx_materializations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/materialized_buffer"}
    },
    "xadx_execution": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/rounds"}
    },
    "xadx_provenance": {
      "type": "object",
      "required": [
        "recipe_sha256", "manifest_sha256", "serializer",
        "generator_version", "executables"
      ],
      "additionalProperties": false,
      "properties": {
        "recipe_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "generator_version": {"const": "kernel-recipe-generator-v1"},
        "serializer": {
          "type": "object",
          "required": ["api", "revision"],
          "additionalProperties": false,
          "properties": {
            "api": {"const": "hrx_amdxdna_xadx_serialize"},
            "revision": {"const": "hrx-amdxdna-v0"}
          }
        },
        "executables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/executable"}
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "profile-v1.schema.json"}
    },
    "policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "policy-v1.schema.json"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_contract": {
      "type": "object",
      "required": ["readback_capable", "validated_bytes_per_dispatch"],
      "additionalProperties": false,
      "properties": {
        "readback_capable": {"type": "boolean"},
        "validated_bytes_per_dispatch": {"type": "integer", "minimum": 1}
      }
    },
    "materialized_buffer": {
      "type": "object",
      "required": ["source", "size", "sha256", "contract_sha256"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "kernel-recipe-v1.schema.json#/$defs/generator"},
        "size": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "sha256": {"$ref": "#/$defs/sha256"},
        "contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rounds": {
      "type": "object",
      "required": ["lifecycle_rounds", "resident_rounds", "readback_rounds"],
      "additionalProperties": false,
      "properties": {
        "lifecycle_rounds": {"type": "integer", "minimum": 0},
        "resident_rounds": {"type": "integer", "minimum": 0},
        "readback_rounds": {"type": "integer", "minimum": 0}
      }
    },
    "executable": {
      "type": "object",
      "required": [
        "id", "xclbin_path", "xclbin_sha256", "transaction",
        "transaction_sha256", "xadx", "xadx_sha256"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "execution": {"type": "string", "minLength": 1},
        "xclbin_path": {"type": "string", "minLength": 1},
        "xclbin_sha256": {"$ref": "#/$defs/sha256"},
        "transaction": {"type": "string", "minLength": 1},
        "transaction_sha256": {"$ref": "#/$defs/sha256"},
        "xadx": {"type": "string", "minLength": 1},
        "xadx_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
