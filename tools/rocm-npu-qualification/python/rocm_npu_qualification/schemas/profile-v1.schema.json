{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocm.docs.amd.com/rocm-npu/profile-v1.schema.json",
  "title": "ROCm NPU qualification profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "description": {"type": "string", "minLength": 1},
    "extends": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "$defs": {
    "digestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "promptGenerator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "filler_word_count",
        "marker_word_offset",
        "marker"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "context-tail-marker-v1"},
        "filler_word_count": {"type": "integer", "minimum": 1000},
        "marker_word_offset": {"type": "integer", "minimum": 0},
        "marker": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "prompt_generator": {"$ref": "#/$defs/promptGenerator"},
        "expected": {"type": "string", "minLength": 1},
        "expected_regex": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["prompt"]},
          "then": {"required": ["prompt"]},
          "else": {"required": ["prompt_generator"]}
        }
      ],
      "not": {"required": ["expected", "expected_regex"]}
    },
    "runTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "turns",
        "setup_commands",
        "process_iterations",
        "timeout_seconds",
        "ctx_len"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"const": "run"},
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/turn"}
        },
        "setup_commands": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "process_iterations": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "ctx_len": {"type": "integer", "minimum": 1}
      }
    },
    "benchTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "config",
        "timeout_seconds",
        "checkpoint_min",
        "checkpoint_max",
        "expected_regex"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"const": "bench"},
        "config": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "checkpoint_min": {"type": "integer", "minimum": 1},
        "checkpoint_max": {"type": "integer", "minimum": 1},
        "expected_regex": {"type": "string"},
        "iterations": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "source",
        "revision",
        "identity_policy",
        "registry_sha256",
        "files",
        "xclbins",
        "tests"
      ],
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "identity_policy": {
          "enum": ["revision-sha256", "content-sha256"]
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/digestRecord"}
        },
        "xclbins": {
          "type": "array",
          "items": {"$ref": "#/$defs/digestRecord"}
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/runTest"},
              {"$ref": "#/$defs/benchTest"}
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_policy": {"const": "revision-sha256"}
            }
          },
          "then": {
            "properties": {
              "revision": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {"revision": {"const": null}}
          }
        }
      ]
    }
  }
}
