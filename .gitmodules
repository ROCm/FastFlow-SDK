[submodule "projects/llvm-project"]
	path = projects/llvm-project
	url = https://github.com/ROCm/llvm-project.git
[submodule "projects/iron-tools"]
	path = projects/iron-tools
	url = https://github.com/Xilinx/mlir-aie.git
	ignore = dirty
[submodule "projects/hrx"]
	path = projects/hrx
	url = https://github.com/ROCm/hrx-system.git
	ignore = dirty
[submodule "projects/iron-ops"]
	path = projects/iron-ops
	url = https://github.com/amd/IRON.git
	ignore = dirty
[submodule "projects/FastFlowLM"]
	path = projects/FastFlowLM
	url = https://github.com/ROCm/FastFlowLM.git
	branch = main
	ignore = dirty
