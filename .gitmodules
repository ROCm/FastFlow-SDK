[submodule "projects/llvm-project"]
	path = projects/llvm-project
	url = https://github.com/jtuyls/llvm-project.git
[submodule "projects/iron-tools"]
	path = projects/iron-tools
	url = https://github.com/Xilinx/mlir-aie.git
	ignore = dirty
[submodule "projects/hrx"]
	path = projects/hrx
	url = https://github.com/jtuyls/hrx.git
	branch = amdxdna-hal-native
[submodule "projects/hrx-xclbinutil"]
	path = projects/hrx-xclbinutil
	url = https://github.com/jtuyls/hrx-xclbinutil.git
	branch = main
[submodule "projects/iron-ops"]
	path = projects/iron-ops
	url = git@github.com:amd/IRON.git
